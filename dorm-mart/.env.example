# Copy to .env.development for local development; fill in your own credentials.
# PHP reads .env.development by default. Set APP_ENV in the server environment
# to select another .env.<environment>, or set ENV_FILE to an explicit file.
# REACT_APP_* values are public and bundled into the frontend. Never put secrets there.

# Local React dev server and PHP API (npm start + npm run start:api).
PUBLIC_URL=
REACT_APP_API_BASE=http://localhost:8080/api
REACT_APP_CHAT_NOTIFICATION_ON=true
FRONTEND_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local MySQL. Replace these values for your database.
DB_HOST=127.0.0.1
DB_NAME=dorm_mart
DB_USERNAME=root
DB_PASSWORD=

# Accounts and proxy configuration.
ALLOW_ALL_EMAILS=true
TRUST_PROXY_GEO_HEADERS=false

# Optional upload root; blank uses the app's default storage location.
# On Railway, set this to a mounted volume directory.
DATA_UPLOADS_DIR=

# Set long, random secrets to enable WebSocket tokens and signed unsubscribe links.
WS_TOKEN_SECRET=
PROMO_UNSUBSCRIBE_SECRET=

# Real Stripe payments are disabled until explicitly enabled and configured.
PAYMENTS_ENABLED=false

# Resend HTTPS email API. Takes priority over SMTP when set.
# MAIL_FROM_EMAIL must use a verified Resend domain for real recipients.
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Dorm Mart
MAIL_REPLY_TO_EMAIL=
MAIL_REPLY_TO_NAME=Dorm Mart Support
SUPPORT_EMAIL=

# SMTP fallback when RESEND_API_KEY is empty. For Gmail, use an app password.
GMAIL_USERNAME=
GMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_TIMEOUT=10
SMTP_ALLOW_SELF_SIGNED=false

# Stripe test mode. Seed accounts use mock transactions without Stripe keys.
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_TEST_SECRET_KEY=sk_test_replace_me
STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TEST_ACCOUNT_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TEST_PAYMENT_METHOD_CONFIGURATION=pmc_replace_me

# Stripe live mode. Unprotected accounts use these credentials.
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_LIVE_SECRET_KEY=sk_live_replace_me
STRIPE_LIVE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_ACCOUNT_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_PAYMENT_METHOD_CONFIGURATION=pmc_replace_me

# Cloudflare Turnstile. When both are set, login asks for a human check after
# repeated failures instead of locking out. Leave empty to keep the plain lockout.
# Test keys (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
