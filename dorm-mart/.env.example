# Application URLs and database settings are deployment-specific.
PAYMENTS_ENABLED=false

# Resend HTTPS email API. Takes priority over SendGrid and SMTP when set.
# MAIL_FROM_EMAIL must use a verified Resend domain for real recipients.
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Dorm Mart
MAIL_REPLY_TO_EMAIL=

# Stripe test mode. Protected seed accounts use these credentials.
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_TEST_SECRET_KEY=sk_test_replace_me
STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TEST_ACCOUNT_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TEST_PAYMENT_METHOD_CONFIGURATION=pmc_replace_me

# Stripe live mode. Unprotected accounts use these credentials.
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_LIVE_SECRET_KEY=sk_live_replace_me
STRIPE_LIVE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_ACCOUNT_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LIVE_PAYMENT_METHOD_CONFIGURATION=pmc_replace_me

# Cloudflare Turnstile. When both are set, login asks for a human check after
# repeated failures instead of locking out. Leave empty to keep the plain lockout.
# Test keys (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
