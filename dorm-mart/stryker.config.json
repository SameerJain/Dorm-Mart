{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for the pure frontend helpers that have their own unit/adversarial tests. Run: npm run test:mutation. See docs/TESTING_AND_RELIABILITY.md.",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "create-react-app",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "tempDirName_comment": "Not the default .stryker-tmp: Jest 27 skips dot-directories, so it found no tests in the sandbox.",
  "tempDirName": "stryker-tmp",
  "mutate": [
    "src/utils/formatters.js",
    "src/utils/imageFallback.js",
    "src/utils/csrfFetch.js",
    "src/utils/apiClient.js",
    "src/utils/numericInputKeyHandlers.js",
    "src/utils/productDetails.js",
    "src/pages/Search/utils/searchResultsUtils.js",
    "src/pages/Home/utils/homeFeedUtils.js",
    "src/pages/SellerDashboard/utils/sellerDashboardUtils.js",
    "src/pages/ScheduledPurchases/utils/ongoingPurchaseViewUtils.js",
    "src/pages/ScheduledPurchases/utils/scheduledPurchaseUtils.js",
    "src/pages/ScheduledPurchases/utils/schedulePurchaseFormUtils.js",
    "src/pages/ScheduledPurchases/utils/scheduleDateTimeUtils.js",
    "src/pages/Wishlist/utils/wishlistUtils.js",
    "src/pages/Settings/userPreferencesUtils.js",
    "src/pages/Settings/loggedDevicesUtils.js",
    "src/pages/Settings/accountInfoUtils.js",
    "src/pages/Chat/utils/chatPageUtils.js",
    "src/pages/ItemForms/utils/listingFormConfig.js",
    "src/pages/AccountCreation/accountCreationRequest.js",
    "src/context/chatContextUtils.js"
  ],
  "ignorePatterns_comment": "gitignore syntax: keep the leading slash, or 'images' also drops src/assets/images and component tests fail to resolve imports.",
  "ignorePatterns": [
    "/api",
    "/vendor",
    "/build",
    "/data",
    "/images",
    "/media",
    "/schema",
    "/phpmyadmin",
    "/public",
    "/reports",
    "/coverage"
  ],
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "concurrency": 4,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 85, "low": 70, "break": null }
}
